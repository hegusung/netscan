[Global]
session = Unknown

[Elasticsearch]
enabled = false
index = pentest
host = 127.0.0.1
port = 9200
ssl = false
username = 
password = 
enable_file_storage = false
document_storage_file = /tmp/es_file_storage.txt

[Neo4J]
host = 127.0.0.1
username = neo4j
password = netscan

[Server]
bind_ip = 0.0.0.0
enable_http = true
http_port = 8000
enable_smb = true
enable_ldap = true
ldap_port = 3890

[ReverseshellListener]
bind_ip = 0.0.0.0
bind_port = 4444

[Logging]
enabled = false
folder = logs/
