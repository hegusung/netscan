#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

#########################
###       CONFIG      ###
#########################
RED="\e[31m"
ENDCOLOR="\e[0m"

# Make paths robust relative to this script’s location
SCRIPT_DIR_REAL="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
SCRIPTS_DIR="${SCRIPT_DIR_REAL}/scripts"

# Virtualenv settings
VENV_DIR="${SCRIPT_DIR_REAL}/.venv"
REQUIREMENTS_FILE="${SCRIPT_DIR_REAL}/requirements.txt"

#########################
###   ENV / DETECT    ###
#########################
in_container() {
  # Detect Docker/Podman/K8s style cgroups or marker files
  [[ -f "/.dockerenv" ]] && return 0
  [[ -f "/run/.containerenv" ]] && return 0
  grep -qaE '(docker|containerd|kubepods|libpod)' /proc/1/cgroup 2>/dev/null && return 0
  return 1
}

# Decide whether to use a venv (default yes on host; no in containers or if DISABLE_VENV=1)
if in_container || [[ "${DISABLE_VENV:-0}" == "1" ]]; then
  USE_VENV=0
else
  USE_VENV=1
fi

#########################
###     FUNCTIONS     ###
#########################
usage(){
    echo -e "Usage: $0 <module> [options]\n"
    echo -e "Modules available :"
    find "$SCRIPTS_DIR" -maxdepth 1 -type f \
      | sed "s#${SCRIPTS_DIR}/##g" | sed 's/.py$//g' \
      | sort | sed 's/^/        - /g'
    echo -e "        - shell"
    echo -e "\nOptions :"
    echo -e "\t-h : Display help"
    echo ""
    exit "${1:-0}"
}

activate_venv() {
  echo "Activating venv"
  # Activate only if not already this venv
  if [[ -z "${VIRTUAL_ENV:-}" || "$VIRTUAL_ENV" != "$VENV_DIR" ]]; then
    # shellcheck disable=SC1090
    source "${VENV_DIR}/bin/activate"
  fi
}

ensure_venv() {
  if [[ ! -d "$VENV_DIR" || ! -x "${VENV_DIR}/bin/python" ]]; then
    PYTHON_BIN=""

    # 1. Prefer pyenv if available
    if command -v pyenv >/dev/null 2>&1; then
      if pyenv versions --bare | grep -q '^3\.12'; then
        echo "[+] Using pyenv Python 3.12"
        PYTHON_BIN="$(pyenv prefix 3.12)/bin/python3.12"
      else
        echo -e "${RED}[!] pyenv found, but no Python 3.12 installed.${ENDCOLOR}"
      fi
    fi

    # 2. Otherwise try system python3.12
    if [[ -z "$PYTHON_BIN" ]]; then
      if command -v python3.12 >/dev/null 2>&1; then
        echo "[+] Using system python3.12"
        PYTHON_BIN="python3.12"
      fi
    fi

    # 3. Fail if none available
    if [[ -z "$PYTHON_BIN" ]]; then
      echo -e "${RED}[!] Python 3.12 not available via pyenv or system.${ENDCOLOR}"
      exit 2
    fi

    echo "[+] Creating virtual environment in ${VENV_DIR} with $PYTHON_BIN"
    "$PYTHON_BIN" -m venv "$VENV_DIR"
    activate_venv
    python -m pip install --upgrade pip wheel >/dev/null
    if [[ -f "$REQUIREMENTS_FILE" ]]; then
      echo "[+] Installing requirements from ${REQUIREMENTS_FILE}"
      pip install -r "$REQUIREMENTS_FILE"
    fi
  else
    activate_venv
  fi
}

#########################
###     ARGS MGMT     ###
#########################
MODULE_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      HELP=YES
      shift
      ;;
    *)
      MODULE_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- "${MODULE_ARGS[@]:-}"

#########################
###       CHECKS      ###
#########################
if [[ $# -gt 0 ]]; then
  MODULE="$1"
  shift

  if (( USE_VENV )); then
    ensure_venv
  else
    echo "[+] Container detected (or DISABLE_VENV=1): skipping virtualenv; using system Python."
  fi

  if [[ "$MODULE" == "shell" ]]; then
    if (( USE_VENV )); then
      echo "[+] Opening shell in venv: ${VENV_DIR}"
    else
      echo "[+] Opening shell (no venv)."
    fi
    exec /bin/bash -i
  fi

  if [[ ! -f "${SCRIPTS_DIR}/${MODULE}.py" ]]; then
    echo -e "${RED}[!] Module \"${MODULE}\" not found.${ENDCOLOR}\n"
    usage 1
  fi
else
  usage 0
fi

if [[ -n "${HELP:-}" ]]; then
  if [[ -n "${MODULE:-}" ]]; then
    python "${SCRIPTS_DIR}/${MODULE}.py" -h
    exit 0
  else
    usage 0
  fi
fi

#########################
###       MAIN        ###
#########################
python "${SCRIPTS_DIR}/${MODULE}.py" "$@"

